# Copy to .env. Defaults are Cloudflare's public Turnstile TEST keys: they work on
# localhost and always pass. Replace both with real keys for the "real-keys" case.
PUBLIC_TURNSTILE_SITEKEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Rate limits (window in seconds)
RATE_LIMIT_WINDOW=600
RATE_LIMIT_PER_PHONE=3
RATE_LIMIT_PER_IP=10
